#!/bin/bash
# DaoHui: run the built DaoHui.app's own librime on its SharedSupport data,
# without installing anything (macOS; used by the CI workflow).
#
#   smoke_daohui_rime deploy <DaoHui.app> <work dir>
#       rime_deployer --build with an empty user folder, as on a first
#       start: fails unless asus_zhuyin and its dictionary compile.
#
#   smoke_daohui_rime keys <DaoHui.app> <work dir>
#       Builds tools/rime_keys.c against the app's librime.1.dylib (so
#       librime also loads the app's rime-plugins) and types a few key
#       sequences into asus_zhuyin with an empty user folder: the Lua scripts
#       run on macOS's librime-lua. Fails if librime cannot start or the
#       schema cannot be selected; prints what the schema shows and any Lua
#       errors from the log. Also fails if BackSpace after finished
#       syllables leaves the typed keys showing instead of Chinese.

set -euo pipefail

mode="${1:?usage: smoke_daohui_rime deploy|keys <DaoHui.app> <work dir>}"
app="$(cd "${2:?DaoHui.app}" && pwd)"
work="${3:?work dir}"
root="$(cd "$(dirname "$0")/.." && pwd)"
shared="${app}/Contents/SharedSupport"
frameworks="${app}/Contents/Frameworks"

rm -rf "${work}"
mkdir -p "${work}/user" "${work}/log"

case "${mode}" in
deploy)
    user="${work}/user"
    start=$(date +%s)
    "${app}/Contents/MacOS/rime_deployer" --build "${user}" "${shared}" "${user}/build"
    echo "rime_deployer --build took $(( $(date +%s) - start )) s"
    ls -l "${user}/build"
    status=0
    # librime builds into the user folder only what differs from the prebuilt
    # data in SharedSupport/build (package/prebuild_shared); with an empty user
    # folder that is usually nothing.
    deployed() {
        if [ -s "${user}/build/$1" ]; then
            echo "${user}/build/$1"
        elif [ -s "${shared}/build/$1" ]; then
            echo "${shared}/build/$1"
        fi
    }
    for f in default.yaml asus_zhuyin.schema.yaml asus_zhuyin.prism.bin terra_pinyin.asus.table.bin; do
        found="$(deployed "${f}")"
        case "${found}" in
            "${user}"/*) echo "ok    build/${f}" ;;
            "") echo "FAIL  build/${f} was not built"; status=1 ;;
            *) echo "ok    build/${f} (prebuilt one in SharedSupport/build is up to date)" ;;
        esac
    done
    if grep -q 'schema: asus_zhuyin' "$(deployed default.yaml)" 2>/dev/null; then
        echo "ok    schema_list of the deployed default.yaml has asus_zhuyin"
    else
        echo "FAIL  asus_zhuyin is not in the deployed schema_list"
        status=1
    fi
    exit "${status}"
    ;;
keys)
    tool="${work}/rime_keys"
    clang -std=c11 -Wall -Wextra -o "${tool}" "${root}/tools/rime_keys.c" \
        -I "${root}/librime/src" -L "${frameworks}" -lrime.1 -Wl,-rpath,"${frameworks}"
    # ㄋㄧˇ ㄏㄠˇ (你好) in the Dachen layout, then Escape; an English word.
    start=$(date +%s)
    status=0
    perl -e 'alarm 900; exec @ARGV' "${tool}" "${shared}" "${work}/user" "${work}/log" asus_zhuyin \
        'su3cl3' '{Escape}' 'hello' '{Escape}' > "${work}/keys.out" || status=$?
    echo "rime_keys took $(( $(date +%s) - start )) s, exit ${status}"
    cat "${work}/keys.out"
    echo "--- log files"
    ls -l "${work}/log" || true
    if ls "${work}/log"/*.ERROR* > /dev/null 2>&1; then
        echo "--- errors logged by librime (last 60 lines)"
        tail -60 "${work}/log"/*.ERROR*
    fi
    lua_errors="$(cat "${work}/log"/*.WARNING* 2>/dev/null | grep -ci 'lua' || true)"
    echo "info  log lines mentioning Lua at WARNING or above: ${lua_errors}"
    if grep -q '你好' "${work}/keys.out"; then
        echo "ok    你好 is offered for su3cl3"
    else
        echo "warn  你好 not offered for su3cl3"
    fi
    # BackSpace after finished syllables deletes one character at a time
    # (lua/asus_keys.lua); what is left must still show as Chinese, not as
    # the keys typed (seen on a Mac with 1.1.2.18).
    echo "--- BackSpace"
    perl -e 'alarm 900; exec @ARGV' "${tool}" "${shared}" "${work}/user" "${work}/log" asus_zhuyin \
        'ji3rup wu0 cp3cl3' '{BackSpace}' '{BackSpace}' '{BackSpace}' '{Escape}' \
        'su3cl3a87' '{BackSpace}' '{BackSpace}' '{Escape}' \
        '5k4ek7jp4wu6' '{BackSpace}' '{BackSpace}' '{Escape}' \
        'su3cl' '{BackSpace}' '{BackSpace}' '{Escape}' > "${work}/backspace.out" || status=$?
    cat "${work}/backspace.out"
    if ls "${work}/log"/*.ERROR* > /dev/null 2>&1; then
        echo "--- errors logged by librime after BackSpace (last 40 lines)"
        tail -40 "${work}/log"/*.ERROR*
    fi
    # The first three words end with a tone key at every step: no keys shown.
    keys_shown="$(awk -F'\t' '$1 == "su3cl" { stop = 1 }
        !stop && $1 == "{BackSpace}" && $2 == "preview" && $3 ~ /[A-Za-z0-9]/' \
        "${work}/backspace.out" | head -6)"
    if [ -n "${keys_shown}" ]; then
        echo "FAIL  keys shown after BackSpace:"
        echo "${keys_shown}"
        status=1
    else
        echo "ok    BackSpace leaves Chinese"
    fi
    # Ctrl+R (lua/asus_fix.lua) with rime_keys answering as DaoHuiAI.swift
    # would: the IME shows 應用城市 for these keys; the correction must be
    # shown (it reads as typed: ReverseLookup, OpenCC s2tw) and committed.
    echo "--- Ctrl+R"
    want='請重新啟動應用程式'
    perl -e 'alarm 900; exec @ARGV' "${tool}" "${shared}" "${work}/user" "${work}/log" asus_zhuyin \
        '@opt:_asus_fix=1' 'fu/3tj/6vup fu32j/4u/4m/4t/6g4' '{Control+r}' "@answer:${want}" '{Return}' \
        > "${work}/fix.out" || status=$?
    grep -v $'\t[0-9]*\t' "${work}/fix.out" || true
    shown="$(awk -F'\t' '$1 ~ /^@answer:/ && $2 == "preview" { print $3 }' "${work}/fix.out")"
    committed="$(awk -F'\t' '$1 == "{Return}" && $2 == "commit" { print $3 }' "${work}/fix.out")"
    if [ "${shown}" = "${want}" ] && [ "${committed}" = "${want}" ]; then
        echo "ok    Ctrl+R: the correction is shown and Enter commits it"
    else
        echo "FAIL  Ctrl+R: shown '${shown}', committed '${committed}', want '${want}'"
        status=1
    fi
    if ls "${work}/log"/*.ERROR* > /dev/null 2>&1 && grep -q "asus_fix" "${work}/log"/*.ERROR*; then
        echo "FAIL  Lua errors from asus_fix:"
        grep "asus_fix" "${work}/log"/*.ERROR* | tail -5
        status=1
    fi
    exit "${status}"
    ;;
*)
    echo "unknown mode ${mode}" >&2
    exit 2
    ;;
esac
