#!/bin/bash
# DaoHui: run the built DaoHui.app's own librime on its SharedSupport data,
# without installing anything (macOS; used by the CI workflow).
#
#   smoke_daohui_rime deploy <DaoHui.app> <work dir>
#       rime_deployer --build with an empty user folder, as on a first
#       start: fails unless asus_zhuyin and its dictionary compile.
#
#   smoke_daohui_rime keys <DaoHui.app> <work dir>
#       Builds tools/rime_keys.c against the app's librime.1.dylib (so
#       librime also loads the app's rime-plugins) and types a few key
#       sequences into asus_zhuyin with an empty user folder: the Lua scripts
#       run on macOS's librime-lua. Fails if librime cannot start or the
#       schema cannot be selected; prints what the schema shows and any Lua
#       errors from the log.

set -euo pipefail

mode="${1:?usage: smoke_daohui_rime deploy|keys <DaoHui.app> <work dir>}"
app="$(cd "${2:?DaoHui.app}" && pwd)"
work="${3:?work dir}"
root="$(cd "$(dirname "$0")/.." && pwd)"
shared="${app}/Contents/SharedSupport"
frameworks="${app}/Contents/Frameworks"

rm -rf "${work}"
mkdir -p "${work}/user" "${work}/log"

case "${mode}" in
deploy)
    user="${work}/user"
    start=$(date +%s)
    "${app}/Contents/MacOS/rime_deployer" --build "${user}" "${shared}" "${user}/build"
    echo "rime_deployer --build took $(( $(date +%s) - start )) s"
    ls -l "${user}/build"
    status=0
    for f in default.yaml asus_zhuyin.schema.yaml asus_zhuyin.prism.bin terra_pinyin.asus.table.bin; do
        if [ -s "${user}/build/${f}" ]; then
            echo "ok    build/${f}"
        else
            echo "FAIL  build/${f} was not built"
            status=1
        fi
    done
    if grep -q 'schema: asus_zhuyin' "${user}/build/default.yaml" 2>/dev/null; then
        echo "ok    schema_list of the deployed default.yaml has asus_zhuyin"
    else
        echo "FAIL  asus_zhuyin is not in the deployed schema_list"
        status=1
    fi
    exit "${status}"
    ;;
keys)
    tool="${work}/rime_keys"
    clang -std=c11 -Wall -Wextra -o "${tool}" "${root}/tools/rime_keys.c" \
        -I "${root}/librime/src" -L "${frameworks}" -lrime.1 -Wl,-rpath,"${frameworks}"
    # ㄋㄧˇ ㄏㄠˇ (你好) in the Dachen layout, then Escape; an English word.
    start=$(date +%s)
    status=0
    perl -e 'alarm 900; exec @ARGV' "${tool}" "${shared}" "${work}/user" "${work}/log" asus_zhuyin \
        'su3cl3' '{Escape}' 'hello' '{Escape}' > "${work}/keys.out" || status=$?
    echo "rime_keys took $(( $(date +%s) - start )) s, exit ${status}"
    cat "${work}/keys.out"
    echo "--- log files"
    ls -l "${work}/log" || true
    if ls "${work}/log"/*.ERROR* > /dev/null 2>&1; then
        echo "--- errors logged by librime (last 60 lines)"
        tail -60 "${work}/log"/*.ERROR*
    fi
    lua_errors="$(cat "${work}/log"/*.WARNING* 2>/dev/null | grep -ci 'lua' || true)"
    echo "info  log lines mentioning Lua at WARNING or above: ${lua_errors}"
    if grep -q '你好' "${work}/keys.out"; then
        echo "ok    你好 is offered for su3cl3"
    else
        echo "warn  你好 not offered for su3cl3"
    fi
    exit "${status}"
    ;;
*)
    echo "unknown mode ${mode}" >&2
    exit 2
    ;;
esac
