#!/bin/bash
set -e

# DaoHui: runs as root after DaoHui.pkg is installed, by Installer.app, by the
# settings app or by Sparkle (for an install still in /Library/Input Methods).
# Only DaoHui.app is touched (a stock Squirrel.app next to it is not).
login_user=`/usr/bin/stat -f%Su /dev/console`
squirrel_app_root="${DSTROOT}/DaoHui.app"

/usr/bin/sudo -u "${login_user}" /usr/bin/killall DaoHui > /dev/null || true

# No `DaoHui --build` in SharedSupport here, unlike stock Squirrel: the shared
# data is prebuilt when the package is made (package/prebuild_shared), so the
# installed bundle keeps an intact signature.

if [ "`/usr/bin/id -u`" != 0 ]; then
    # make install-debug / install-release: already in the user's session
    "${squirrel_app_root}/Contents/MacOS/DaoHui" --update-input-source || true
    exit 0
fi
login_uid=`/usr/bin/id -u "${login_user}" 2> /dev/null || true`
if [ -z "${login_uid}" ] || [ "${login_uid}" = 0 ] || [ "${login_user}" = _mbsetupuser ]; then
    echo "DaoHui: nobody is logged in at the console; it stays in ${DSTROOT} and macOS finds it at the next login."
    exit 0
fi

# Since 1.1.2.21 DaoHui lives in the login user's ~/Library/Input Methods: it
# belongs to the user there, and Sparkle updates it in the background without
# an administrator password (DAOHUI.md, "Updates"). The package installs into
# /Library/Input Methods (installing runs as root, from any account), and the
# app is moved from there. If that fails, it stays where it was installed.
move_to_user() {
    local home user_methods group
    home=`/usr/bin/dscl . -read "/Users/${login_user}" NFSHomeDirectory 2> /dev/null | /usr/bin/awk '{print $2}'`
    [ -n "${home}" ] && [ -d "${home}/Library" ] && [ -d "${squirrel_app_root}" ] || return 1
    user_methods="${home}/Library/Input Methods"
    group=`/usr/bin/id -gn "${login_user}"`
    /usr/bin/sudo -u "${login_user}" /bin/mkdir -p "${user_methods}" || return 1
    /bin/rm -rf "${user_methods}/DaoHui.app.new"
    /usr/bin/ditto "${squirrel_app_root}" "${user_methods}/DaoHui.app.new" || return 1
    /usr/sbin/chown -R "${login_user}:${group}" "${user_methods}/DaoHui.app.new" || return 1
    /bin/rm -rf "${user_methods}/DaoHui.app"
    /bin/mv "${user_methods}/DaoHui.app.new" "${user_methods}/DaoHui.app" || return 1
    /bin/rm -rf "${squirrel_app_root}"
    squirrel_app_root="${user_methods}/DaoHui.app"
}
if move_to_user; then
    echo "DaoHui: moved to ${squirrel_app_root}"
else
    echo "DaoHui: could not move DaoHui.app into ~/Library/Input Methods of ${login_user}; it stays in ${DSTROOT}."
fi

# Register, enable and select the input source in the login user's GUI
# session. Installing replaces the whole bundle, which leaves a stale, greyed
# out entry in the user's input sources until the next login. Stock Squirrel
# runs these steps as root or with a plain `sudo -u`, which keeps the
# installer's bootstrap: the calls never reach the user's text input server
# and answer "already registered/enabled" from a stale view.
/bin/launchctl asuser "${login_uid}" \
    /usr/bin/sudo -u "${login_user}" -H "${squirrel_app_root}/Contents/MacOS/DaoHui" --update-input-source || true
