# DaoHui: keep LF line endings in every checkout, also on Windows (the build
# runs on macOS; shell scripts and the Xcode project must not get CRLF).
* text=auto eol=lf

# Binary assets
*.pdf binary
*.png binary
*.icns binary
*.ocd2 binary
*.gram binary

# GitHub language statistics: daohui-data/ is a copy of the Windows fork's
# built data (see DAOHUI.md), so its Lua stays out of the language bar.
daohui-data/** linguist-vendored
